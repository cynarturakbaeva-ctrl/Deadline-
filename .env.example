# Жергілікті іске қосу үшін үлгі. Көшіріңіз: cp .env.example .env  және мәндерді өзіңіз толтырыңыз.
# DATABASE_URL ЖОҚ болса — дерекқор жергілікті JSON файл: data/db.json (PostgreSQL керек емес).

# Telegram бот (тест бот жасаңыз: @BotFather) — тек бот/Mini App керек болса
TELEGRAM_BOT_TOKEN=
ADMIN_CHAT_ID=
WEBAPP_DEV=1
PORT=3000

# Мазмұн (презентация жасау үшін міндетті)
DEEPSEEK_API_KEY=

# Суреттер (міндетті емес — жоқ болса тек кілтсіз ашық базалар)
PEXELS_API_KEY=
# Суретті көзбен таңдау: DEEPSEEK_API_KEY жеткілікті (deepseek-flash суретті көреді). Google — тек AI сурет жасау үшін.
GOOGLE_API_KEY=
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
EUROPEANA_API_KEY=
# AI сурет өшіру: IMAGE_GEN=0

# Жаңарту режимі: 1 → тек админ мен тестерлер жасатады, клиентке «жаңартылып жатыр»
MAINTENANCE=1
